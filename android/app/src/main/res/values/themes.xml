<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash theme: the system splash screen (Android 12+) and the window before Compose draws. -->
    <style name="Theme.SantaliSpeaks.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_sand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.SantaliSpeaks</item>
        <item name="android:windowBackground">@color/brand_sand</item>
    </style>

    <!-- Base theme after splash. Compose Material 3 theme is applied inside MainActivity. -->
    <style name="Theme.SantaliSpeaks" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_sand</item>
        <item name="android:statusBarColor">@color/brand_sand</item>
        <item name="android:navigationBarColor">@color/brand_sand</item>
    </style>
</resources>

    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_body">Santali Speaks reads Santali text written in Ol Chiki aloud. It is built for Santali speakers and learners, and it does not translate or transliterate your text.</string>
    <string name="about_speech_engine">Speech is generated by the BHASHINI platform (National Language Translation Mission, Government of India) through the Santali Speaks server.</string>
    <string name="about_font">Ol Chiki text uses Noto Sans Ol Chiki, licensed under the SIL Open Font License 1.1.</string>
    <string name="about_website">Website: speaks.santals.in</string>
    <string name="about_privacy_policy">Privacy policy</string>
    <string name="about_open_source_licenses">Font license</string>
    <string name="about_verification">Speech quality is still being reviewed by native Santali speakers. If a sentence sounds wrong, please tell us.</string>

    <!-- Onboarding -->
    <string name="onboarding_title_1">Copy, speak, listen</string>
    <string name="onboarding_body_1">Select Santali text in Ol Chiki in any app, copy it, then open Santali Speaks and tap Speak. You can also choose Speak in Santali from the text menu.</string>
    <string name="onboarding_title_2">Works offline too</string>
    <string name="onboarding_body_2">New speech needs an internet connection. Readings you have already listened to are saved on this device and play without internet.</string>
    <string name="onboarding_title_3">Your privacy</string>
    <string name="onboarding_body_3">The app never reads your clipboard in the background. Your text is sent only when you tap Speak. Turn on notifications to control playback from the lock screen.</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_start">Get started</string>
    <string name="onboarding_allow_notifications">Allow notifications</string>

